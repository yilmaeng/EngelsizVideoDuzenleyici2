{
  "name": "evd",
  "version": "4.7.0",
  "description": "Bir video oynatıcıyı klavyeyle kontrol eden el ve kulak - Görme engelli kullanıcılar için erişilebilir video düzenleme",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:win": "set ELECTRON_RUN_AS_NODE= && electron .",
    "dev": "electron . --enable-logging",
    "prepare:mac": "node build/prepare-mac-build-config.js",
    "build": "electron-builder",
    "generate:tutorials": "node build/generate-tutorials-json.js",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File build\\build-win-release.ps1 -Version %npm_package_version%",
    "build:instant-voice-translation": "powershell -NoProfile -ExecutionPolicy Bypass -File build\\build-instant-voice-translation.ps1 -Version %npm_package_version%",
    "build:instant-voice-translation:mac": "npm run build:native-audio:mac && electron-builder --config build/instant-voice-translation-mac-builder.js --mac dmg --arm64",
    "test:instant-voice-translation:mac": "node build/validate-instant-voice-translation-mac.js",
    "build:win:dir": "electron-builder --win dir --x64",
    "build:mac": "npm run build:native-audio:mac && npm run prepare:mac && electron-builder --mac dmg --arm64",
    "build:native-audio:mac": "bash build/build-native-audio-mac.sh",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "deploy:broadcast-room": "powershell -NoProfile -ExecutionPolicy Bypass -File build\\deploy-broadcast-room.ps1",
    "test": "echo \"Test komutları henüz eklenmedi\" && exit 0"
  },
  "build": {
    "appId": "com.engelsiz.videoeditor",
    "productName": "Engelsiz Video Düzenleyicisi",
    "copyright": "© 2025-2026 Engin Yılmaz",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Start_icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "Start_icon.png",
      "category": "public.app-category.video",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "type": "development"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "Start_icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "EVD-Setup-v${version}.${ext}",
      "shortcutName": "EVD",
      "createDesktopShortcut": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "tr",
        "en",
        "de",
        "es",
        "fr"
      ]
    },
    "files": [
      "src/**/*",
      "Start_icon.png",
      "Geçiş Sesleri/**/*",
      "Animation Sounds/**/*",
      "!src/resources/**/*",
      "!src/test/**/*",
      "!**/*.md",
      "!**/*.map",
      "!**/*.log",
      "!**/backup_*/**/*",
      "!**/.agent/**/*"
    ],
    "extraResources": [
      {
        "from": "src/resources/deepfilter",
        "to": "deepfilter"
      },
      {
        "from": "src/resources/rnnoise",
        "to": "rnnoise"
      },
      {
        "from": "src/resources/obs-studio",
        "to": "obs-studio"
      },
      {
        "from": "tools/EvdProcessLoopbackCapture/bin/Release/net8.0-windows/win-x64/publish",
        "to": "native-audio"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@ffprobe-installer/**/*",
      "node_modules/sharp/**/*",
      "node_modules/say/**/*",
      "node_modules/@xenova/**/*",
      "src/renderer/assets/**/*"
    ],
    "npmRebuild": true,
    "publish": null
  },
  "keywords": [
    "video-editor",
    "accessibility",
    "screen-reader",
    "nvda",
    "jaws",
    "blind",
    "keyboard"
  ],
  "author": "Engin Yılmaz",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@xenova/transformers": "^2.17.2",
    "edge-tts": "^1.0.1",
    "electron-store": "^11.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "jimp": "^1.6.0",
    "node-gtts": "^2.0.2",
    "obs-websocket-js": "^5.0.6",
    "say": "^0.16.0",
    "sharp": "^0.34.5",
    "wav": "^1.0.2"
  }
}
